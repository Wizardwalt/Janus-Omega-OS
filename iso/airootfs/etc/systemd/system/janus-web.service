[Unit]
Description=JanusOS Web Server
Documentation=https://github.com/Wizardwalt/Janus-Omega-OS
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/opt/janus/janus-web
WorkingDirectory=/opt/janus
Restart=always
RestartSec=3
Environment=RUST_LOG=info
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
