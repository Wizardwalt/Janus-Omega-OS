# Replace janus.example.com with the customer-controlled production hostname.
# Caddy obtains and renews HTTPS certificates automatically when DNS/public
# reachability are correctly configured.
janus.example.com {
    encode zstd gzip

    # The dashboard is the only public Janus service.
    reverse_proxy 127.0.0.1:5000

    # Basic browser security headers. Adjust CSP only after testing external
    # assets used by the dashboard.
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }

    log {
        output file /var/log/caddy/janus-access.log
    }
}
