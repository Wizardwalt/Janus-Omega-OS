[Unit]
Description=Janus authorized-services runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=janus
Group=janus
WorkingDirectory=/opt/janus
EnvironmentFile=/etc/janus/janus.env
ExecStart=/opt/janus/bin/janus-runtime --config /etc/janus/janus.runtime.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/janus /var/log/janus

[Install]
WantedBy=multi-user.target
