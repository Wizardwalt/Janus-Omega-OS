<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.JanusOmega" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/janus_purple</item>
        <item name="colorPrimaryVariant">@color/janus_purple</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/janus_bg</item>
        <item name="android:navigationBarColor">@color/janus_bg</item>
        <item name="android:windowBackground">@color/janus_bg</item>
    </style>

    <style name="TabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">true</item>
    </style>
</resources>
