hidden = ["target", ".cargo"]

entrypoint = "src/main.rs"
modules = ["rust-stable", "python-3.11"]

[nix]
channel = "stable-24_05"
packages = ["jq", "openssl", "pkg-config", "udev", "android-tools", "libimobiledevice", "nvidia-docker", "graalvmCEPackages.graalnodejs"]

[gitHubImport]
requiredFiles = [".replit"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run Application"

[[workflows.workflow]]
name = "Run Application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cargo run"
waitForPort = 5000

[deployment]
deploymentTarget = "vm"
run = ["cargo", "run", "--release"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5904
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 9090
externalPort = 3001
